generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Authentication & Users ───────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  passwordHash   String
  zipCode        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appliances     Appliance[]
  alertSettings  AlertSetting[]
}

// ─── Appliances & Manuals ─────────────────────────────────────────────

model ApplianceCategory {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "HVAC", "Plumbing", "Kitchen", "Laundry"
  icon        String?  // icon name or path
  description String?

  appliances  Appliance[]
  guides      Guide[]
  serviceProviders ServiceProvider[]
}

model Appliance {
  id            String   @id @default(uuid())
  userId        String
  categoryId    String
  nickname      String?  // e.g. "Kitchen Fridge"
  brand         String?
  modelNumber   String
  serialNumber  String?
  purchaseDate  DateTime?
  warrantyEnd   DateTime?
  location      String?  // e.g. "Kitchen", "Basement"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ApplianceCategory @relation(fields: [categoryId], references: [id])
  manuals       ApplianceManual[]
  maintenanceTasks MaintenanceTask[]

  @@index([userId])
  @@index([modelNumber])
}

model ApplianceManual {
  id           String   @id @default(uuid())
  applianceId  String
  title        String
  fileUrl      String   // URL or path to manual PDF/document
  manualType   String   // "owner_manual", "quick_start", "service_manual", "warranty"
  createdAt    DateTime @default(now())

  appliance    Appliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)

  @@index([applianceId])
}

// ─── Maintenance Scheduling & Alerts ──────────────────────────────────

model MaintenanceTask {
  id              String   @id @default(uuid())
  applianceId     String
  title           String          // e.g. "Replace HVAC Filter"
  description     String?
  intervalMonths  Int             // how often (in months) this should be done
  lastCompletedAt DateTime?
  nextDueAt       DateTime
  isRecurring     Boolean  @default(true)
  priority        String   @default("medium") // "low", "medium", "high"
  status          String   @default("upcoming") // "upcoming", "due", "overdue", "completed"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appliance       Appliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)

  @@index([applianceId])
  @@index([nextDueAt])
  @@index([status])
}

model AlertSetting {
  id              String   @id @default(uuid())
  userId          String
  alertType       String   // "email", "push", "sms"
  enabled         Boolean  @default(true)
  daysBefore      Int      @default(7) // alert X days before due date
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Public Knowledge Base ────────────────────────────────────────────

model Guide {
  id          String   @id @default(uuid())
  categoryId  String?
  title       String
  slug        String   @unique
  summary     String
  content     String   // rich text / markdown content
  difficulty  String   @default("beginner") // "beginner", "intermediate", "advanced"
  imageUrl    String?
  tags        String?  // comma-separated tags
  viewCount   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ApplianceCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
}

// ─── Service Provider Directory ───────────────────────────────────────

model ServiceProvider {
  id          String   @id @default(uuid())
  categoryId  String?
  name        String
  trade       String   // "plumber", "electrician", "hvac_tech", "general_contractor", etc.
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ApplianceCategory? @relation(fields: [categoryId], references: [id])

  @@index([trade])
  @@index([zipCode])
}
